{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["dev", "prod"]
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        }
      },
      "required": ["mode"]
    },
    "db": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": ["host", "port"]
    },
    "simulators": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ble": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deviceName": {
              "type": "string"
            }
          },
          "required": ["deviceName"]
        }
      }
    }
  },
  "required": ["app", "db"]
}
